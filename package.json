{
  "name": "nextjs-starter-spree",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "next dev -p 3001 --turbopack",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "biome lint .",
    "format": "biome format . --write",
    "check": "biome check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:locales": "tsx scripts/check-locale-parity.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "e2e:up": "docker compose -f e2e-backend/docker-compose.yml up -d --wait && ./scripts/e2e/bootstrap-spree.sh",
    "e2e:down": "docker compose -f e2e-backend/docker-compose.yml down -v",
    "devir:login": "tsx scripts/devir-b2b-login.ts",
    "devir:scan": "tsx scripts/devir-b2b-sync.ts",
    "devir:import:dry-run": "tsx scripts/devir-b2b-import.ts",
    "devir:review": "tsx scripts/devir-b2b-review.ts",
    "devir:sync:once": "tsx scripts/devir-b2b-loop.ts --once",
    "devir:sync:watch": "tsx scripts/devir-b2b-loop.ts",
    "devir:spree:setup": "tsx scripts/devir-b2b-spree.ts setup",
    "devir:spree:sync": "tsx scripts/devir-b2b-spree.ts sync",
    "devir:spree:status": "tsx scripts/devir-b2b-spree.ts status",
    "devir:spree:categories": "tsx scripts/devir-b2b-spree.ts categories",
    "devir:spree:margin": "tsx scripts/devir-b2b-spree.ts margin",
    "devir:spree:margin-product": "tsx scripts/devir-b2b-spree.ts margin-product",
    "devir:spree:activate": "tsx scripts/devir-b2b-spree.ts activate",
    "devir:hyper:scan": "tsx scripts/devir-b2b-sync.ts --hyper",
    "devir:hyper:resume": "tsx scripts/devir-b2b-sync.ts --hyper --resume",
    "devir:hyper:once": "tsx scripts/devir-b2b-loop.ts --once --hyper",
    "devir:hyper:watch": "tsx scripts/devir-b2b-loop.ts --hyper"
  },
  "dependencies": {
    "@adyen/adyen-web": "^6.33.0",
    "@next/third-parties": "^16.1.6",
    "@paypal/react-paypal-js": "^9.1.1",
    "@puckeditor/core": "^0.23.0",
    "@sentry/nextjs": "^10.38.0",
    "@spree/sdk": "^1.2.1",
    "@stripe/react-stripe-js": "^5.6.0",
    "@stripe/stripe-js": "^8.7.0",
    "@supabase/supabase-js": "^2.116.0",
    "@swc/helpers": "^0.5.21",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "next": "^16",
    "next-intl": "^4.9.2",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19",
    "react-dom": "^19",
    "react-email": "^6.1.4",
    "react-svg-credit-card-payment-icons": "^5.1.2",
    "resend": "^6.9.4",
    "shadcn": "^4.0.2",
    "sonner": "^2.0.7",
    "swiper": "^12.1.2",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "overrides": {
    "minimatch": "^10.2.1",
    "postcss": "^8.5.10",
    "mute-stream": "^3.0.0",
    "sharp": "^0.35.3",
    "@hono/node-server": "^2.0.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@playwright/test": "^1.60.0",
    "@spree/cli": "^2.0.0",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.4",
    "jsdom": "^28.0.0",
    "lefthook": "^2.1.2",
    "shadcn": "^4.0.2",
    "tailwindcss": "^4",
    "tsx": "^4.19.0",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
