{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["dub1"],
  "git": {
    "deploymentEnabled": {
      "main": false,
      "chore/retire-devir": false,
      "fix/daily-offers": false,
      "fix/storefront-stability-consumption": false,
      "fix/owned-stock-offer-limits": false,
      "fix/exclude-french-italian": false,
      "perf/storefront-loading": false,
      "perf/catalog-translation-cost": false,
      "perf/one-dollar-daily": false,
      "perf/half-dollar-daily": false,
      "perf/backend-budget-fixed-offers": false,
      "fix/ig-daily-quota-recovery": false,
      "migration/spree-owned-backend": false
    }
  },
  "crons": [
    { "path": "/api/cron/offers", "schedule": "1,3,5,10,20,40 3,4 * * *" },
    { "path": "/api/cron/offers", "schedule": "15 8,12,16,20 * * *" }
  ]
}
