# Spree API Configuration (server-side only)
SPREE_API_URL=http://localhost:3000
SPREE_PUBLISHABLE_KEY=your_publishable_api_key_here

# Puck editor access (server-side only; never expose to browser)
PUCK_EDITOR_PASSWORD=change-me

# Stripe Live direct integration. The secret/webhook keys are server-side only.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_key_here
STRIPE_SECRET_KEY=sk_live_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_signing_secret
SPREE_STRIPE_EXTERNAL_PAYMENT_METHOD_ID=pm_8aKR0I7fEb

# Transactional email provider — server-side only.
# Existing Spree webhooks send order confirmations, cancellations, shipment
# updates and password resets automatically. Set gmail to send through Gmail
# without ChatGPT. Gmail OAuth must be authorized once with the gmail.send scope
# and offline access so the backend can refresh tokens by itself.
EMAIL_PROVIDER=gmail
EMAIL_FROM=BisonTCG <your-account@gmail.com>
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Optional fallback provider. Used when EMAIL_PROVIDER=resend, or automatically
# when EMAIL_PROVIDER is unset and Gmail is not configured.
RESEND_API_KEY=
