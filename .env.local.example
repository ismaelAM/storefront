# Spree API Configuration (server-side only)
SPREE_API_URL=http://localhost:3000
SPREE_PUBLISHABLE_KEY=your_publishable_api_key_here

# Puck editor access (server-side only; never expose to browser)
PUCK_EDITOR_PASSWORD=change-me

# Stripe client key. The secret key lives in the Stripe payment method configured in Spree.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
