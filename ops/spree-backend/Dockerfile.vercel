# Official Spree 5.6.1, linux/amd64; upstream revision 86aff8be595f326da2144909cfb5b080a7525e55.
FROM ghcr.io/spree/spree@sha256:b62cb3973a9bb8db1363344597963fa7e212fd2a86d0e9796bbcb1d892048645
WORKDIR /rails
COPY --chown=1000:1000 --chmod=644 start.sh target.rb ./
COPY --chown=1000:1000 config/database.yml config/storage.yml config/queue.yml ./config/
COPY --chown=1000:1000 config/initializers/bisontcg.rb config/initializers/runtime_guard.rb ./config/initializers/
COPY --chown=1000:1000 config/initializers/recovery_identity.rb ./config/initializers/
COPY --chown=1000:1000 operations/email-activation.rb operations/email-http-drain.rb ./
COPY --chown=1000:1000 operations/email-http-initializer.rb ./config/initializers/bison_email_http.rb
COPY --chown=1000:1000 operations/email-activation.test.rb operations/email-http-drain.test.rb ./
COPY --chown=1000:1000 operations/payment-setup.rb operations/payment-setup.test.rb ./
COPY --chown=1000:1000 operations/payment-http-initializer.rb ./config/initializers/bison_payment_http.rb
COPY --chown=1000:1000 operations/shipping-setup.rb operations/shipping-setup.test.rb ./
COPY --chown=1000:1000 operations/shipping-http-initializer.rb ./config/initializers/bison_shipping_http.rb
COPY --chown=1000:1000 app/views/admin_users/registrations/new.html.erb ./app/views/admin_users/registrations/new.html.erb
# The mounted Spree engine shares the admin_user Devise mapping and uses a singular scoped path.
COPY --chown=1000:1000 app/views/admin_users/registrations/new.html.erb ./app/views/admin_user/registrations/new.html.erb
RUN ruby -c target.rb && ruby -c config/initializers/bisontcg.rb && ruby -c config/initializers/runtime_guard.rb && ruby -c config/initializers/recovery_identity.rb && sh -n start.sh
RUN ruby -c email-activation.rb && ruby -c email-http-drain.rb && ruby -c config/initializers/bison_email_http.rb && ruby email-activation.test.rb && ruby email-http-drain.test.rb
RUN ruby -c payment-setup.rb && ruby -c config/initializers/bison_payment_http.rb && ruby payment-setup.test.rb
RUN ruby -c shipping-setup.rb && ruby -c config/initializers/bison_shipping_http.rb && bundle exec ruby shipping-setup.test.rb
ENV RAILS_ENV=production PORT=3000 RAILS_MAX_THREADS=3 SOLID_QUEUE_IN_PUMA=false PIDFILE=/tmp/spree.pid TARGET_SUPABASE_PROJECT_REF=dtrospakebdiqihhcrub
# Bypass upstream entrypoint: it runs db:prepare on each web startup.
ENTRYPOINT ["/bin/sh", "/rails/start.sh"]
