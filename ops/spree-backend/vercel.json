{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": { "deploymentEnabled": { "migration/spree-owned-backend": false } },
  "framework": "container",
  "regions": ["dub1"],
  "daemons": {
    "publish_catalog": {
      "root": ".",
      "entrypoint": "operations/Dockerfile",
      "command": ["/bin/sh", "/rails/publish-catalog.sh"],
      "instances": { "dub1": 0 },
      "resources": { "requests": { "memory": "1Gi" } }
    },
    "import_media": {
      "root": ".",
      "entrypoint": "operations/Dockerfile",
      "command": ["/bin/sh", "/rails/import-media.sh", "100"],
      "instances": { "dub1": 0 },
      "resources": { "requests": { "memory": "1Gi" } }
    },
    "import_catalog": {
      "root": ".",
      "entrypoint": "operations/Dockerfile",
      "command": ["/bin/sh", "/rails/import-catalog.sh"],
      "instances": { "dub1": 0 },
      "resources": { "requests": { "memory": "1Gi" } }
    },
    "worker": {
      "root": ".",
      "entrypoint": "operations/Dockerfile",
      "command": ["/bin/sh", "/rails/worker.sh"],
      "instances": { "dub1": 0 },
      "resources": { "requests": { "memory": "1Gi" } }
    },
    "configure_store": {
      "root": ".",
      "entrypoint": "operations/Dockerfile",
      "command": ["/bin/sh", "/rails/configure-store.sh"],
      "instances": { "dub1": 0 },
      "resources": { "requests": { "memory": "1Gi" } }
    },
    "initialize": {
      "root": ".",
      "entrypoint": "operations/Dockerfile",
      "instances": { "dub1": 0 },
      "resources": { "requests": { "memory": "1Gi" } }
    }
  }
}
