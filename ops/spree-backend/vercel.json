{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "migration/spree-owned-backend": false
    }
  },
  "framework": "container",
  "regions": [
    "dub1"
  ],
  "daemons": {
    "worker": {
      "root": ".",
      "entrypoint": "Dockerfile.operations",
      "command": [
        "/bin/sh",
        "/rails/worker.sh"
      ],
      "instances": {
        "dub1": 0
      },
      "resources": {
        "requests": {
          "memory": "1Gi"
        }
      }
    }
  }
}
